@@ -0,0 +1,22 @@
+#pragma once
+#include <cstdint>
+#include <limits>
+
+namespace dxmt {
+
+// Both planes have the same byte pitch; UV follows all Y rows.
+struct NV12Layout {
+  uint32_t pitch;
+  uint32_t uvOffset;
+  uint32_t size;
+
+  static constexpr bool valid(uint32_t width, uint32_t height, uint32_t pitch) {
+    return width && height && !(width & 1) && !(height & 1) && pitch >= width &&
+           uint64_t(pitch) * (uint64_t(height) + height / 2) <= std::numeric_limits<uint32_t>::max();
+  }
+  static constexpr NV12Layout get(uint32_t height, uint32_t pitch) {
+    return {pitch, pitch * height, pitch * (height + height / 2)};
+  }
+};
+
+} // namespace dxmt
