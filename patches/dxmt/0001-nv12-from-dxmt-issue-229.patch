+#include "../src/dxmt/dxmt_nv12.hpp"
+#include <cassert>
+#include <cstdio>
+
+int main() {
+  using dxmt::NV12Layout;
+  static_assert(NV12Layout::valid(1920, 1080, 2048));
+  constexpr auto layout = NV12Layout::get(1080, 2048);
+  static_assert(layout.uvOffset == 2211840 && layout.size == 3317760);
+  assert(!NV12Layout::valid(1919, 1080, 2048));
+  assert(!NV12Layout::valid(1920, 1079, 2048));
+  assert(!NV12Layout::valid(1920, 1080, 1919));
+  assert(!NV12Layout::valid(2, 2, UINT32_MAX));
+  assert(!NV12Layout::valid(0, 0, 0));
+  // Last useful UV byte stays inside a padded allocation.
+  assert(layout.uvOffset + (1080 / 2 - 1) * layout.pitch + 1920 <= layout.size);
+  std::puts("NV12 layout checks passed");
+}
