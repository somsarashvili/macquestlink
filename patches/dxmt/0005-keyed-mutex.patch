+static uint64_t
+NowUs() {
+  LARGE_INTEGER c, f;
+  QueryPerformanceCounter(&c);
+  QueryPerformanceFrequency(&f);
+  return c.QuadPart * 1000000ull / f.QuadPart;
+}
+
 HRESULT
 KeyedMutex::acquire(KeyedMutexAcquire &&func_acquire, uint64_t key, uint32_t milliseconds) {
   /**
@@ -135,18 +145,46 @@ KeyedMutex::acquire(KeyedMutexAcquire &&func_acquire, uint64_t key, uint32_t mil
   acquire.hKeyedMutex = local_kmt_;
   acquire.Key = key;
   acquire.pTimeout = &timeout;
-  timeout.QuadPart = milliseconds * -10000;
 
-  NTSTATUS status = D3DKMTAcquireKeyedMutex(&acquire);
+  // Wine's D3DKMTAcquireKeyedMutex returns STATUS_TIMEOUT immediately while the other side holds the key, so the
+  // requested timeout is honored here. Between attempts, sleep until the holder's release signals the shared event
+  // (briefly yielding after a signal, as the CPU-side release can trail it) instead of busy polling the wineserver.
+  NTSTATUS status;
+  uint64_t deadline = NowUs() + uint64_t(milliseconds) * 1000;
+  uint64_t seen = event_.signaledValue();
+  uint64_t spin_until = 0;
+  for (;;) {
+    status = D3DKMTAcquireKeyedMutex(&acquire);
+    uint64_t now = NowUs();
+    if (status != STATUS_TIMEOUT || now >= deadline)
+      break;
+    if (now < spin_until) {
+      SwitchToThread();
+      continue;
+    }
+    uint64_t remaining_ms = (deadline - now + 999) / 1000;
+    if (event_.waitUntilSignaledValue(seen + 1, remaining_ms < 2 ? remaining_ms : 2)) {
+      seen = event_.signaledValue();
+      spin_until = NowUs() + 500;
+    }
+  }
   if (status == STATUS_TIMEOUT)
     return WAIT_TIMEOUT;
   if (status == STATUS_ABANDONED_WAIT_0)
     return WAIT_ABANDONED;
   if (status) {
-    WARN("KeyedMutex: Failed to acquire keyed mutex.");
+    WARN("KeyedMutex: Failed to acquire keyed mutex, status=", status);
     return E_FAIL;
   }
 
+  // The GPU-side wait in func_acquire only orders this device. Consumers often acquire on one device just to sync
+  // (SteamVR's sync texture) and then read the shared textures on another device or thread, which Windows orders
+  // implicitly, so a process that opened the mutex waits here until the releasing device's GPU work has completed.
+  // The creating process (a game with its own sync texture) keeps the GPU-side wait only, and with it its CPU/GPU
+  // overlap.
+  static const bool wait_on_acquire = Config::getInstance().getOption<bool>("dxgi.keyedMutexWaitOnAcquire", true);
+  if (wait_on_acquire && imported_)
+    event_.waitUntilSignaledValue(acquire.FenceValue, 100);
   func_acquire(acquire.FenceValue);
 
   fence_value_ = acquire.FenceValue;
@@ -169,8 +207,8 @@ KeyedMutex::release(KeyedMutexRelease &&func_release, uint64_t key) {
