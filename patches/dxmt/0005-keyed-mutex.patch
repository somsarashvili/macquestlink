 namespace dxmt {
 
+static std::mutex g_queues_mutex;
+static std::set<CommandQueue *> g_queues;
+
+// Work that a keyed-mutex release made visible to other processes must reach the GPU even if this process exits
+// right away; Metal drops a dying process's in-flight command buffers.
+void
+CommandQueue::WaitAllCommittedOnExit() {
+  std::lock_guard<std::mutex> lock(g_queues_mutex);
+  for (auto queue : g_queues)
+    queue->event.waitUntilSignaledValue(queue->committed_event_id_.load(), 1000);
+}
