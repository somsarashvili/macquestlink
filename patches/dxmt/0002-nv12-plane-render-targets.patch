     if (!(pDevice->GetLocalD3DKMT() & 0xc0000000)) {
       ERR("DeviceTexture: Invalid device handle");
       return E_FAIL;
@@ -520,8 +521,13 @@ ImportSharedTextureInternal(
   typename tag::DESC1 finalDesc;
   if (FAILED(CreateMTLTextureDescriptor(pDevice, pDescUnchecked, &finalDesc, &info)))
     return E_INVALIDARG;
+  // only the luma plane is exported
+  if (finalDesc.Format == DXGI_FORMAT_NV12) {
+    ERR("ImportSharedTexture: NV12 import not supported");
+    return E_INVALIDARG;
+  }
 
-  auto texture = Rc<Texture>(new Texture(info, pDevice->GetMTLDevice(), finalDesc.Format == DXGI_FORMAT_NV12));
+  auto texture = Rc<Texture>(new Texture(info, pDevice->GetMTLDevice()));
   auto allocation = texture->import(MachPort);
   if (!allocation)
     return E_FAIL;
