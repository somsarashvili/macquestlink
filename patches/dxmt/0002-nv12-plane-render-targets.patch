@@ -311,7 +311,7 @@ CreateMTLTextureDescriptorInternal(
     if (Dimension != D3D11_RESOURCE_DIMENSION_TEXTURE2D || !NV12Layout::valid(Width, Height, Width) ||
         ArraySize > D3D11_REQ_TEXTURE2D_ARRAY_AXIS_DIMENSION ||
         Width > D3D11_REQ_TEXTURE2D_U_OR_V_DIMENSION || Height > D3D11_REQ_TEXTURE2D_U_OR_V_DIMENSION ||
-        MipLevels > 1 || SampleCount != 1 || MiscFlags ||
+        MipLevels > 1 || SampleCount != 1 || (MiscFlags & ~D3D11_RESOURCE_MISC_SHARED) ||
         (BindFlags & ~(D3D11_BIND_SHADER_RESOURCE | D3D11_BIND_RENDER_TARGET |
                        D3D11_BIND_DECODER | D3D11_BIND_VIDEO_ENCODER)) ||
         (Usage == D3D11_USAGE_DYNAMIC && CPUAccessFlags != D3D11_CPU_ACCESS_WRITE) ||
@@ -392,8 +392,11 @@ CreateMTLTextureDescriptorInternal(
   }
 
   // Media Foundation may request RT/decoder binds without creating render/video views.
-  if (Format == DXGI_FORMAT_NV12)
+  if (Format == DXGI_FORMAT_NV12) {
     metal_usage = WMTTextureUsageShaderRead;
+    if (BindFlags & D3D11_BIND_RENDER_TARGET)
+      metal_usage |= WMTTextureUsageRenderTarget;
+  }
   pDescOut->usage = metal_usage;
 
   WMTResourceOptions options = (WMTResourceOptions)0;
diff --git a/src/d3d11/d3d11_resource_view_helper.cpp b/src/d3d11/d3d11_resource_view_helper.cpp
index abf53b9..a19fa4a 100644
--- a/src/d3d11/d3d11_resource_view_helper.cpp
+++ b/src/d3d11/d3d11_resource_view_helper.cpp
@@ -365,6 +365,44 @@ HRESULT InitializeAndNormalizeViewDescriptor(
     MTLD3D11Device *pDevice, unsigned MiplevelCount, unsigned ArraySize, Texture* pTexture,
     D3D11_RENDER_TARGET_VIEW_DESC1 &ViewDesc, MTL_RENDER_PASS_ATTACHMENT_DESC &AttachmentDesc, TextureViewDescriptor &Descriptor
 ) {
+  if (pTexture->nv12) {
+    UINT plane, mip, first = 0, count = 1;
+    if (ViewDesc.ViewDimension == D3D11_RTV_DIMENSION_TEXTURE2D) {
+      plane = ViewDesc.Texture2D.PlaneSlice;
+      mip = ViewDesc.Texture2D.MipSlice;
+      Descriptor.type = WMTTextureType2D;
+    } else if (ViewDesc.ViewDimension == D3D11_RTV_DIMENSION_TEXTURE2DARRAY) {
+      plane = ViewDesc.Texture2DArray.PlaneSlice;
+      mip = ViewDesc.Texture2DArray.MipSlice;
+      first = ViewDesc.Texture2DArray.FirstArraySlice;
+      count = ViewDesc.Texture2DArray.ArraySize;
+      if (count == UINT(-1) && first < ArraySize)
+        count = ArraySize - first;
+      Descriptor.type = WMTTextureType2DArray;
+    } else {
+      return E_INVALIDARG;
+    }
+    // legacy RTV descs have no PlaneSlice: the chroma plane is selected by its R8G8 format
+    if (ViewDesc.Format == DXGI_FORMAT_R8G8_UNORM)
+      plane = 1;
+    if (plane > 1 || mip || !count || first >= ArraySize || count > ArraySize - first ||
+        ViewDesc.Format != (plane ? DXGI_FORMAT_R8G8_UNORM : DXGI_FORMAT_R8_UNORM))
+      return E_INVALIDARG;
+    Descriptor.format = plane ? WMTPixelFormatRG8Unorm : WMTPixelFormatR8Unorm;
+    Descriptor.plane = plane;
+    Descriptor.firstMiplevel = 0;
+    Descriptor.miplevelCount = 1;
+    Descriptor.firstArraySlice = first;
+    Descriptor.arraySize = count;
+    AttachmentDesc.DepthPlane = 0;
+    AttachmentDesc.SampleCount = 1;
+    AttachmentDesc.RenderTargetArrayLength = Descriptor.type == WMTTextureType2DArray ? count : 0;
+    AttachmentDesc.Width = pTexture->width() >> plane;
+    AttachmentDesc.Height = pTexture->height() >> plane;
+    if (Descriptor.type == WMTTextureType2DArray)
+      ViewDesc.Texture2DArray.ArraySize = count;
+    return S_OK;
+  }
   MTL_DXGI_FORMAT_DESC metal_format;
   if (FAILED(MTLQueryDXGIFormat(pDevice->GetMTLDevice(), ViewDesc.Format,
                                 metal_format))) {
