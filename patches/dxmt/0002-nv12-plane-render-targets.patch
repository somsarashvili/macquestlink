NV12: render-target views on a plane (DESC1 PlaneSlice, or legacy R8_UNORM / R8G8_UNORM views),
RENDER_TARGET format support, D3D11_RESOURCE_MISC_SHARED accepted but kept process-local (vrlink's encode targets).

diff --git a/src/d3d11/d3d11_device.cpp b/src/d3d11/d3d11_device.cpp
index 92a4ada..49e753f 100644
--- a/src/d3d11/d3d11_device.cpp
+++ b/src/d3d11/d3d11_device.cpp
@@ -483,7 +483,8 @@ public:
     if (Format == DXGI_FORMAT_NV12) {
       if (pFormatSupport)
         *pFormatSupport = D3D11_FORMAT_SUPPORT_TEXTURE2D | D3D11_FORMAT_SUPPORT_CPU_LOCKABLE |
-                         D3D11_FORMAT_SUPPORT_SHADER_LOAD | D3D11_FORMAT_SUPPORT_SHADER_SAMPLE;
+                         D3D11_FORMAT_SUPPORT_SHADER_LOAD | D3D11_FORMAT_SUPPORT_SHADER_SAMPLE |
+                         D3D11_FORMAT_SUPPORT_RENDER_TARGET;
       return S_OK;
     }
 
diff --git a/src/d3d11/d3d11_resource_helper.cpp b/src/d3d11/d3d11_resource_helper.cpp
index 540abdd..ba9a1be 100644
