+BufferAllocation::BufferAllocation(
+    WMT::Device device, const WMTBufferInfo &info, Flags<BufferAllocationFlag> flags,
+    void (*release_external)(void *), void *external_context
+) :
+    info_(info),
+    flags_(flags),
+    release_external_(release_external),
+    external_context_(external_context) {
+  suballocation_size_ = info_.length;
+  fenceTrackers.resize(suballocation_count_);
+  obj_ = device.newBuffer(info_);
+  gpuAddress_ = info_.gpu_address;
+  mappedMemory_ = info_.memory.get_accessible_or_null();
+}
+
 void
 BufferAllocation::free() {
   if (placed_buffer) {
     wsi::aligned_free(placed_buffer);
     placed_buffer = nullptr;
   }
+  if (release_external_) {
+    cached_view_.clear();
+    obj_ = nullptr;
+    release_external_(external_context_);
+    release_external_ = nullptr;
+  }
   delete this;
 }
 
