+Rc<BufferAllocation>
+Buffer::allocateExternal(
+    Flags<BufferAllocationFlag> flags, void *memory, uint64_t length, void (*release)(void *), void *context
+) {
+  WMTBufferInfo info;
+  info.memory.set(memory);
+  info.length = length;
+  info.options = WMTResourceHazardTrackingModeUntracked;
+  flags.set(BufferAllocationFlag::ExternalMemory);
+  return new BufferAllocation(device_, info, flags, release, context);
+}
