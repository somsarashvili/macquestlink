+    if (pName) {
+      DWORD session, len, name_len = wcslen(pName);
+      ProcessIdToSessionId(GetCurrentProcessId(), &session);
+      len = swprintf(name, ARRAYSIZE(name), L"\\Sessions\\%u\\BaseNamedObjects\\", session);
+      memcpy(name + len, pName, (name_len + 1) * sizeof(WCHAR));
+      name_str.MaximumLength = name_str.Length = (len + name_len) * sizeof(WCHAR);
+      name_str.MaximumLength += sizeof(WCHAR);
+      name_str.Buffer = name;
+      attr.ObjectName = &name_str;
+      attr.Attributes = OBJ_CASE_INSENSITIVE;
+    }
+
+    if (D3DKMTShareObjects(1, &local_kmt_, &attr, Access, pNTHandle)) {
+      ERR("D3D11Buffer: Failed to create shared handle");
+      return E_FAIL;
+    }
+    return S_OK;
+  }
