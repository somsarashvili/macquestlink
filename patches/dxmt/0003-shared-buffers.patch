 #include "dxmt_dynamic.hpp"
 #include "dxmt_format.hpp"
 #include "d3d11_resource.hpp"
+#include "util_win32_compat.h"
 
 namespace dxmt {
 
+constexpr UINT kSharedBufferMiscFlags =
+    D3D11_RESOURCE_MISC_SHARED | D3D11_RESOURCE_MISC_SHARED_NTHANDLE | D3D11_RESOURCE_MISC_SHARED_KEYEDMUTEX;
+constexpr uint64_t kSharedBufferAlignment = 0x10000;
+
+// Shared buffers live in a named section so every process can map the same pages
+// and wrap them with newBufferWithBytesNoCopy.
+struct SharedBufferMemory {
+  HANDLE mapping;
+  void *view;
+  uint64_t length;
+};
+
+static uint64_t
+SharedBufferLength(UINT ByteWidth) {
+  return (uint64_t(ByteWidth) + kSharedBufferAlignment - 1) & ~(kSharedBufferAlignment - 1);
+}
+
+static SharedBufferMemory *
+MapSharedBufferMemory(const char *name, uint64_t length, bool create) {
+  HANDLE mapping = create ? CreateFileMappingA(INVALID_HANDLE_VALUE, nullptr, PAGE_READWRITE, 0, DWORD(length), name)
+                          : OpenFileMappingA(FILE_MAP_ALL_ACCESS, FALSE, name);
+  if (!mapping)
+    return nullptr;
+  void *view = MapViewOfFile(mapping, FILE_MAP_ALL_ACCESS, 0, 0, length);
+  if (!view) {
+    CloseHandle(mapping);
+    return nullptr;
+  }
+  return new SharedBufferMemory{mapping, view, length};
+}
+
+static void
+ReleaseSharedBufferMemory(void *context) {
+  auto memory = static_cast<SharedBufferMemory *>(context);
+  UnmapViewOfFile(memory->view);
+  CloseHandle(memory->mapping);
+  delete memory;
+}
